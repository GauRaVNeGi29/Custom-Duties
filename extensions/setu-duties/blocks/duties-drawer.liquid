{%- comment -%}
  Setu import duties – "Duties near checkout" app embed.
  Turn on in the theme editor: App embeds → Duties near checkout.
  Mounts the widget just above the checkout buttons on the cart page and in
  slide-out cart drawers. Default selector covers Dwell/Horizon themes (cart
  page summary and drawer) and Dawn drawers. Use it instead of the
  "Import duties estimate" block on themes whose cart summary has no app-block slot.
  Mounting and the checkout lock live in setu-duties-lock.js.
{%- endcomment -%}
<template data-setu-duties-drawer data-selector="{{ block.settings.selector | escape }}">
  {% render 'setu-duties-root', block: block %}
</template>
<script src="{{ 'setu-duties-lock.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Duties near checkout",
  "target": "body",
  "javascript": "setu-duties.js",
  "stylesheet": "setu-duties.css",
  "settings": [
    { "type": "text", "id": "selector", "label": "Position (CSS selector)", "info": "The widget is placed just before this element", "default": ".cart-page__summary .cart__ctas, cart-drawer-component .cart__ctas, cart-drawer .cart__ctas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Estimated import duties & taxes" },
    { "type": "checkbox", "id": "open_detail", "label": "Open the per-category detail by default", "default": false },
    { "type": "header", "content": "Checkout" },
    { "type": "checkbox", "id": "require_destination", "label": "Require a destination before checkout", "info": "Checkout buttons stay visible but disabled until a country is chosen", "default": true },
    { "type": "checkbox", "id": "allow_other", "label": "Offer an Other country option", "info": "Lets customers shipping elsewhere continue without an estimate", "default": true },
    { "type": "text", "id": "checkout_selector", "label": "Checkout button selector (optional)", "info": "Leave blank to detect the theme's checkout buttons" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#1a1a1a" },
    { "type": "checkbox", "id": "show_border", "label": "Show border", "default": false }
  ]
}
{% endschema %}
